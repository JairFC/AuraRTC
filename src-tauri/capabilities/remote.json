{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "remote-access",
    "description": "Allow remote domain to use IPC",
    "windows": ["main"],
    "remote": {
        "urls": ["https://app.sesame.com/*", "https://*.sesame.com/*"]
    },
    "permissions": [
        "core:default",
        "opener:default"
    ]
}
