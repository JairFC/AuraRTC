{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "remote-access",
    "description": "Allow any HTTPS remote domain to use IPC (user configures target URL in aurartc.json)",
    "windows": ["main"],
    "remote": {
        "urls": ["https://*/*"]
    },
    "permissions": [
        "core:default",
        "opener:default"
    ]
}
